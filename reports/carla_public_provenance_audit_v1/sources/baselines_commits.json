"parents":[{"sha":"88217a6d5eea8a0113b39cc8f9282af331f01304","url":"https://api.github.com/repos/carlanomaly/baselines/commits/88217a6d5eea8a0113b39cc8f9282af331f01304","html_url":"https://github.com/carlanomaly/baselines/commit/88217a6d5eea8a0113b39cc8f9282af331f01304"}]},{"sha":"88217a6d5eea8a0113b39cc8f9282af331f01304","node_id":"C_kwDOS7HTFdoAKDg4MjE3YTZkNWVlYThhMDExM2IzOWNjOGY5MjgyYWYzMzFmMDEzMDQ","commit":{"author":{"name":"Konstantin Kirchheim","email":"konstantin.kirchheim@ovgu.de","date":"2026-06-25T17:04:09Z"},"committer":{"name":"Konstantin Kirchheim","email":"konstantin.kirchheim@ovgu.de","date":"2026-06-25T17:30:57Z"},"message":"multimodal: use MaxLogit instead of MSP for learned detectors\n\nThe seg and point detectors in the multimodal max-fusion baseline scored\nwith MSP (1 - max softmax), while the standalone rgb_segmentation and\nlidar_segmentation baselines (which share the same checkpoints) use\nMaxLogit (-max logit). Switch both multimodal detectors to MaxLogit so\nthe per-modality scores are consistent and comparable across baselines.\n\nAlso update download_checkpoints.sh base URL to data.carlanomaly.de/v1.\n\nCo-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>","tree":{"sha":"1dea774ab6fd3b3ca11114614602804f1f2a7ba6","url":"https://api.github.com/repos/carlanomaly/baselines/git/trees/1dea774ab6fd3b3ca11114614602804f1f2a7ba6"},"url":"https://api.github.com/repos/carlanomaly/baselines/git/commits/88217a6d5eea8a0113b39cc8f9282af331f01304","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/carlanomaly/baselines/commits/88217a6d5eea8a0113b39cc8f9282af331f01304","html_url":"https://github.com/carlanomaly/baselines/commit/88217a6d5eea8a0113b39cc8f9282af331f01304","comments_url":"https://api.github.com/repos/carlanomaly/baselines/commits/88217a6d5eea8a0113b39cc8f9282af331f01304/comments","author":{"login":"kkirchheim","id":16308381,"node_id":"MDQ6VXNlcjE2MzA4Mzgx","avatar_url":"https://avatars.githubusercontent.com/u/16308381?v=4","gravatar_id":"","url":"https://api.github.com/users/kkirchheim","html_url":"https://github.com/kkirchheim","followers_url":"https://api.github.com/users/kkirchheim/followers","following_url":"https://api.github.com/users/kkirchheim/following{/other_user}","gists_url":"https://api.github.com/users/kkirchheim/gists{/gist_id}","starred_url":"https://api.github.com/users/kkirchheim/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kkirchheim/subscriptions","organizations_url":"https://api.github.com/users/kkirchheim/orgs","repos_url":"https://api.github.com/users/kkirchheim/repos","events_url":"https://api.github.com/users/kkirchheim/events{/privacy}","received_events_url":"https://api.github.com/users/kkirchheim/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"kkirchheim","id":16308381,"node_id":"MDQ6VXNlcjE2MzA4Mzgx","avatar_url":"https://avatars.githubusercontent.com/u/16308381?v=4","gravatar_id":"","url":"https://api.github.com/users/kkirchheim","html_url":"https://github.com/kkirchheim","followers_url":"https://api.github.com/users/kkirchheim/followers","following_url":"https://api.github.com/users/kkirchheim/following{/other_user}","gists_url":"https://api.github.com/users/kkirchheim/gists{/gist_id}","starred_url":"https://api.github.com/users/kkirchheim/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kkirchheim/subscriptions","organizations_url":"https://api.github.com/users/kkirchheim/orgs","repos_url":"https://api.github.com/users/kkirchheim/repos","events_url":"https://api.github.com/users/kkirchheim/events{/privacy}","received_events_url":"https://api.github.com/users/kkirchheim/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"7e8b8c44726af1753071aa715ddf504b46e2297e","url":"https://api.github.com/repos/carlanomaly/baselines/commits/7e8b8c44726af1753071aa715ddf504b46e2297e","html_url":"https://github.com/carlanomaly/baselines/commit/7e8b8c44726af1753071aa715ddf504b46e2297e"}]},{"sha":"7e8b8c44726af1753071aa715ddf504b46e2297e","node_id":"C_kwDOS7HTFdoAKDdlOGI4YzQ0NzI2YWYxNzUzMDcxYWE3MTVkZGY1MDRiNDZlMjI5N2U","commit":{"author":{"name":"Konstantin Kirchheim","email":"konstantin.kirchheim@ovgu.de","date":"2026-06-16T21:28:16Z"},"committer":{"name":"Konstantin Kirchheim","email":"konstantin.kirchheim@ovgu.de","date":"2026-06-16T21:28:16Z"},"message":"Make baselines reproducible from a fresh clone\n\nSeparate the dataset root from the artifact root, wire up dataset\nauto-download, and add a checkpoint download script so the documented\n\"clone, install, run\" workflow works without manual data prep.\n\n- Dataset reads come from --data-root (default ./data); checkpoints,\n  runs/, and results now write next to each script under\n  baselines/<method>/, matching the documented layout.\n- ScenarioIndex(download=True) by default in every script, with explicit\n  parts per modality; --no-download opts out. frame_prediction (DDP)\n  downloads on rank 0 only, behind a barrier.\n- download_checkpoints.sh fetches the three published checkpoints into\n  baselines/<method>/checkpoints/ (honors CARLANOMALY_BASE_URL).\n- evaluate.py raises a clear error pointing at the download script when a\n  checkpoint is missing, instead of a bare torch.load traceback.\n- Drop hardcoded /data/* paths; weather fast-cache is now opt-in.\n- Add tensorboard to requirements.txt (train scripts import SummaryWriter\n  at module level; it was undeclared and broke a fresh install).\n- gitignore data/ and weather_cache_rgb224/; refresh README + commands.\n\nCo-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>","tree":{"sha":"4dad2d36af097c6b1590dbf89255518002a9921b","url":"https://api.github.com/repos/carlanomaly/baselines/git/trees/4dad2d36af097c6b1590dbf89255518002a9921b"},"url":"https://api.github.com/repos/carlanomaly/baselines/git/commits/7e8b8c44726af1753071aa715ddf504b46e2297e","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/carlanomaly/baselines/commits/7e8b8c44726af1753071aa715ddf504b46e2297e","html_url":"https://github.com/carlanomaly/baselines/commit/7e8b8c44726af1753071aa715ddf504b46e2297e","comments_url":"https://api.github.com/repos/carlanomaly/baselines/commits/7e8b8c44726af1753071aa715ddf504b46e2297e/comments","author":{"login":"kkirchheim","id":16308381,"node_id":"MDQ6VXNlcjE2MzA4Mzgx","avatar_url":"https://avatars.githubusercontent.com/u/16308381?v=4","gravatar_id":"","url":"https://api.github.com/users/kkirchheim","html_url":"https://github.com/kkirchheim","followers_url":"https://api.github.com/users/kkirchheim/followers","following_url":"https://api.github.com/users/kkirchheim/following{/other_user}","gists_url":"https://api.github.com/users/kkirchheim/gists{/gist_id}","starred_url":"https://api.github.com/users/kkirchheim/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kkirchheim/subscriptions","organizations_url":"https://api.github.com/users/kkirchheim/orgs","repos_url":"https://api.github.com/users/kkirchheim/repos","events_url":"https://api.github.com/users/kkirchheim/events{/privacy}","received_events_url":"https://api.github.com/users/kkirchheim/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"kkirchheim","id":16308381,"node_id":"MDQ6VXNlcjE2MzA4Mzgx","avatar_url":"https://avatars.githubusercontent.com/u/16308381?v=4","gravatar_id":"","url":"https://api.github.com/users/kkirchheim","html_url":"https://github.com/kkirchheim","followers_url":"https://api.github.com/users/kkirchheim/followers","following_url":"https://api.github.com/users/kkirchheim/following{/other_user}","gists_url":"https://api.github.com/users/kkirchheim/gists{/gist_id}","starred_url":"https://api.github.com/users/kkirchheim/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kkirchheim/subscriptions","organizations_url":"https://api.github.com/users/kkirchheim/orgs","repos_url":"https://api.github.com/users/kkirchheim/repos","events_url":"https://api.github.com/users/kkirchheim/events{/privacy}","received_events_url":"https://api.github.com/users/kkirchheim/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"66588e15d9f95eb90c10a61c0cf08ce3bc1c9960","url":"https://api.github.com/repos/carlanomaly/baselines/commits/66588e15d9f95eb90c10a61c0cf08ce3bc1c9960","html_url":"https://github.com/carlanomaly/baselines/commit/66588e15d9f95eb90c10a61c0cf08ce3bc1c9960"}]},{"sha":"66588e15d9f95eb90c10a61c0cf08ce3bc1c9960","node_id":"C_kwDOS7HTFdoAKDY2NTg4ZTE1ZDlmOTVlYjkwYzEwYTYxYzBjZjA4Y2UzYmMxYzk5NjA","commit":{"author":{"name":"Konstantin Kirchheim","email":"konstantin.kirchheim@ovgu.de","date":"2026-06-16T15:04:33Z"},"committer":{"name":"Konstantin Kirchheim","email":"konstantin.kirchheim@ovgu.de","date":"2026-06-16T15:04:33Z"},"message":"Rename baselines to descriptive names\n\nRename baseline packages to describe the model/task instead of the\nscoring method or architecture:\n\n  msp          -> rgb_segmentation\n  pointnet     -> lidar_segmentation\n  ffp          -> frame_prediction\n  weather_pred -> weather_prediction\n\nUpdate imports, DATA_ROOT path strings, usage examples and the README\ntable to match. Checkpoint filenames (e.g. deeplabv3_r50_msp.pt) and\nthe MSP scoring-method references are intentionally left unchanged.\n\nAlso folds in pending local edits that were already in the tree: pass\nindex= as a keyword to the dataset constructors, and expand the\npooled-metric docstrings.\n\nCo-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>","tree":{"sha":"fc99182d051af1aa43da9bcb236dc3c31606ecd0","url":"https://api.github.com/repos/carlanomaly/baselines/git/trees/fc99182d051af1aa43da9bcb236dc3c31606ecd0"},"url":"https://api.github.com/repos/carlanomaly/baselines/git/commits/66588e15d9f95eb90c10a61c0cf08ce3bc1c9960","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/carlanomaly/baselines/commits/66588e15d9f95eb90c10a61c0cf08ce3bc1c9960","html_url":"https://github.com/carlanomaly/baselines/commit/66588e15d9f95eb90c10a61c0cf08ce3bc1c9960","comments_url":"https://api.github.com/repos/carlanomaly/baselines/commits/66588e15d9f95eb90c10a61c0cf08ce3bc1c9960/comments","author":{"login":"kkirchheim","id":16308381,"node_id":"MDQ6VXNlcjE2MzA4Mzgx","avatar_url":"https://avatars.githubusercontent.com/u/16308381?v=4","gravatar_id":"","url":"https://api.github.com/users/kkirchheim","html_url":"https://github.com/kkirchheim","followers_url":"https://api.github.com/users/kkirchheim/followers","following_url":"https://api.github.com/users/kkirchheim/following{/other_user}","gists_url":"https://api.github.com/users/kkirchheim/gists{/gist_id}","starred_url":"https://api.github.com/users/kkirchheim/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kkirchheim/subscriptions","organizations_url":"https://api.github.com/users/kkirchheim/orgs","repos_url":"https://api.github.com/users/kkirchheim/repos","events_url":"https://api.github.com/users/kkirchheim/events{/privacy}","received_events_url":"https://api.github.com/users/kkirchheim/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"kkirchheim","id":16308381,"node_id":"MDQ6VXNlcjE2MzA4Mzgx","avatar_url":"https://avatars.githubusercontent.com/u/16308381?v=4","gravatar_id":"","url":"https://api.github.com/users/kkirchheim","html_url":"https://github.com/kkirchheim","followers_url":"https://api.github.com/users/kkirchheim/followers","following_url":"https://api.github.com/users/kkirchheim/following{/other_user}","gists_url":"https://api.github.com/users/kkirc